PORT=4000
DATABASE_URL=postgres://localhost:5432/rakaez
NODE_ENV=development

# سرّ توقيع رموز الدخول (JWT) — لازم تغيّره لقيمة عشوائية طويلة قبل النشر
# الفعلي؛ القيمة الافتراضية بالكود غير آمنة وللتطوير المحلي فقط.
JWT_SECRET=change-me-to-a-long-random-secret

# مفاتيح ميسر (Moyasar) للدفع الإلكتروني — بدونها لن تعمل صفحة الدفع
# ولا تفعيل الاشتراك التلقائي (راجع routes/billing.js و GET /pay).
MOYASAR_PUBLISHABLE_KEY=pk_test_xxx
MOYASAR_SECRET_KEY=sk_test_xxx
